    // Build the GpBinaryV18 Init message: magic F3, kind=0, then body.
    private static byte[] BuildInit()
    {
        // body: 01 08 sdk_enc vcombined patch revision pad + 32-byte appid  (7 + 32 = 39 bytes)
        byte sdk_enc = (byte)(15 << 1);              // client_sdk_id=15
        byte vcombined = (byte)(((4 & 0x07) << 4) | (1 & 0x0F)); // version 4.1.6.8, no ipv6 -> 0x41
        var body = new List<byte>
        {
            0x01, 0x08, sdk_enc, vcombined, 0x06, 0x08, 0x00
        };
        byte[] appid = new byte[32];
        byte[] appRaw = Encoding.UTF8.GetBytes(AppId);
        Array.Copy(appRaw, appid, Math.Min(32, appRaw.Length));
        body.AddRange(appid);
        return Wrap(KindInit, body);
    }

    private static byte[] BuildOperation(byte opCode, List<byte> paramBytes)
    {
        var body = new List<byte> { opCode };
        body.AddRange(paramBytes);
        return Wrap(KindOperation, body);
    }

