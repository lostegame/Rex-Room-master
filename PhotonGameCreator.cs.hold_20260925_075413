using System;
using System.Collections.Generic;
using System.Net;
using System.Net.Sockets;
using System.Text;

namespace OpenRec_2;

// A minimal, byte-exact Photon GpBinaryV18 + ENet serialization client used to
// pre-create the game room (which the RecRoom client later joins) on the Luxon
// MasterServer, before the real client issues its JoinGame(CreateIfNotExists=false).
public static class PhotonGameCreator
{
    // ------------------------------------------------------------------
    // Config (must match the app + game the RecRoom client will target)
    // ------------------------------------------------------------------
    public const string MasterServerHost = "127.0.0.1";
    public const int MasterServerPort = 5055;
    public const string GameServerHost = "127.0.0.1";
    public const int GameServerPort = 5056;
    // Unique per server boot: a fresh GameId guarantees we never collide with a
    // stale room still registered on the Photon Master (the root cause of the
    // endless "already exists (rc=32766), no token" loop that blocked dorm joins).
    public static readonly string GameId = Guid.NewGuid().ToString("D");

    // AppId used by the RecRoom client (Photon Realtime). Set AppVersion to the
    // exact version string the client authenticates with so the pre-created game
    // lands in the SAME app instance (App::get is keyed by {id, version}).
    public static string AppId = "0000000000000000000000000000000A";
    // MUST match the exact version string the real client sends on the
    // MasterServer (seen in luxon log: "version 20230414_prod_2.22").
    // Luxon keys each game in an app instance by {id, version}; creating the
    // room under a different version string makes it invisible to the client's
    // JoinGame(CreateIfNotExists=false) -> it silently disconnects (~4s).
    public static string AppVersion = "20230414_prod_2.22";

    // ENet constants
    private const byte CmdAcknowledge = 1;
    private const byte CmdConnect = 2;
    private const byte CmdVerifyConnect = 3;
    private const byte CmdSendReliable = 6;
    private const byte CmdPing = 8;
    private const byte FlagReliable = 1;
    private const byte ControlChannel = 255;

    // GpBinaryV18 kind bytes
    private const byte KindInit = 0;
    private const byte KindInitResponse = 1;
    private const byte KindOperation = 2;
    private const byte KindOperationResponse = 3;
    private const byte KindEvent = 4;

    private const byte TCString = 0x07;
    private const byte TCByteZero = 0x22;
    private const byte TCBooleanTrue = 0x1C;

    // OpCodes (Luxon common_codes.hpp)
    private const byte OpAuthenticate = 230;
    private const byte OpCreateGame = 227;
    private const byte OpJoinGame = 226;

    // DictKeyCodes
    private const byte KeyLobbyStats = 211;
    private const byte KeyLobbyType = 212;
    private const byte KeyLobbyName = 213;
    private const byte KeyCreateIfNotExists = 215;
    private const byte KeyClientAuthType = 217;
    private const byte KeyAppVersion = 220;
    private const byte KeyToken = 221;
    private const byte KeyAppId = 224;
    private const byte KeyUserId = 225;
    private const byte KeyGameId = 255;

    // ErrorCodes
    private const short ReturnOk = 0;
    private const short GameIdAlreadyExists = -3;
    // Luxon forked ErrorCodes::Matchmaking::GameIdAlreadyExists is 32766
    // (0x7FFE), not Photon's -3. Both mean the room id is already registered.
    private const int LuxonGameIdAlreadyExists = 32766;

    public sealed class Result
    {
        public bool Success;
        public string Message = "";
        public int CreateGameReturnCode = int.MinValue;
        internal EnetClient LivePeer;   // kept-open connection when Success (room held alive)
    }

    // Dorm "GameServer leg": the master's CreateGame only registers the room in
    // the lobby games list (is_created stays false), so a real client gets
    // 32758 (GameIdNotExists) from validate_join. To raise is_created we must:
    //   1) create the room on the MasterServer and capture its token;
    //   2) close the master connection (this stores the persistent peer +
    //      invitation server-side; detection ~9s, storage expires after 30s);
    //   3) connect to the GameServer with that token (TokenAuth) and re-CreateGame
    //      the same id -> handler_gameserver.cpp:397 sets is_created=true.
    // The returned LivePeer is the GS connection; keeping it alive counts as a
    // peer in the room (same role the old master-only connection held).
    public static Result EnsureDormReady(string lobbyName = "")
    {
        var res = new Result();
        try
        {
            // ---- leg 1: master create + capture token ----
            int createRc = int.MinValue;
            string token = null;
            using (var cli = new UdpClient())
            {
                cli.Connect(MasterServerHost, MasterServerPort);
                cli.Client.ReceiveTimeout = 600;
                var peer = new EnetClient(cli);
                try
                {
                    if (!peer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8))) { res.Message = "GS-leg: ENet handshake failed."; return res; }
                    var init = BuildInit();
                    if (!peer.WaitPhase(init, out _)) { res.Message = "GS-leg: Init failed."; return res; }
                    var auth = BuildOperation(OpAuthenticate, BuildAuthParams());
                    if (!peer.WaitPhase(auth, out _) || peer.LastResponseOperationCode != OpAuthenticate || peer.LastResponseReturnCode != ReturnOk)
                    { res.Message = $"GS-leg: Auth failed op={peer.LastResponseOperationCode} rc={peer.LastResponseReturnCode}."; return res; }

                    var c = BuildOperation(OpCreateGame, BuildCreateGameParams(null, lobbyName));
                    if (!peer.WaitPhase(c, out _)) { res.Message = "GS-leg: CreateGame silent."; return res; }
                    createRc = peer.LastResponseReturnCode;
                    token = peer.LastResponseToken;
                }
                finally { peer.Close(); }   // <- server stores the persistent peer here
            }
            res.CreateGameReturnCode = createRc;

            if (createRc == GameIdAlreadyExists || createRc == LuxonGameIdAlreadyExists)
            {
                // Room already registered but we have no matching token -> can't
                // raise is_created for it in this cycle. Wait for the room to be
                // reaped (empty_game_ttl=0) and retry on the next loop tick.
                res.Message = $"GS-leg: room '{GameId}' already exists (rc={createRc}), no token; waiting for expiry + retry.";
                return res;
            }
            if (createRc != ReturnOk || string.IsNullOrEmpty(token))
            {
                res.Message = $"GS-leg: create rc={createRc} token='{token}' (need rc=0 + token).";
                return res;
            }

            // Let the master detect the closed connection and store the
            // persistent peer (detection ~9s, stored peer expires after 30s).
            System.Threading.Thread.Sleep(15000);

            // ---- leg 2: GameServer TokenAuth + CreateGame -> is_created=true ----
            var gcli = new UdpClient();
            gcli.Connect(GameServerHost, GameServerPort);
            gcli.Client.ReceiveTimeout = 600;
            var gpeer = new EnetClient(gcli);
            res.LivePeer = gpeer;
            try
            {
                if (!gpeer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8))) { res.Message = "GS-leg: GS ENet handshake failed."; return res; }
                var ginit = BuildInit();
                if (!gpeer.WaitPhase(ginit, out _)) { res.Message = "GS-leg: GS Init failed."; return res; }
                var gauth = BuildOperation(OpAuthenticate, BuildTokenAuthParams(token));
                if (!gpeer.WaitPhase(gauth, out _)) { res.Message = "GS-leg: GS TokenAuth silent."; return res; }
                if (gpeer.LastResponseReturnCode != ReturnOk)
                { res.Message = $"GS-leg: GS TokenAuth rc={gpeer.LastResponseReturnCode} (expected 0)."; return res; }

                var gc = BuildOperation(OpCreateGame, BuildCreateGameParams(null, lobbyName));
                if (!gpeer.WaitPhase(gc, out _)) { res.Message = "GS-leg: GS CreateGame silent."; return res; }
                if (gpeer.LastResponseReturnCode != ReturnOk)
                { res.Message = $"GS-leg: GS CreateGame rc={gpeer.LastResponseReturnCode} (expected 0)."; return res; }

                res.Success = true;
                res.Message = $"Dorm '{GameId}' is_created raised (create={createRc}, GS-Auth=0, GS-Create=0). Room held via GS connection.";
                return res;
            }
            finally
            {
                if (!res.Success) gpeer.Close();
            }
        }
        catch (Exception ex)
        {
            res.Message = $"PhotonGameCreator.EnsureDormReady exception: {ex.GetType().Name}: {ex.Message}";
            return res;
        }
    }

    public static Result CreateGame(string lobbyName = "")
    {
        var res = new Result();
        try
        {
            var cli = new UdpClient();
            cli.Connect(MasterServerHost, MasterServerPort);
            cli.Client.ReceiveTimeout = 600;

            var peer = new EnetClient(cli);
            res.LivePeer = peer;

            // 1) Connect handshake
            if (!peer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8)))
            {
                peer.Close();
                res.Message = "ENet handshake failed (no VerifyConnect).";
                return res;
            }

            // 2) Init
            var init = BuildInit();
            if (!peer.WaitPhase(init, out var initRespTime))
            {
                peer.Close();
                res.Message = "Init failed (no InitResponse).";
                return res;
            }

            // 3) Authenticate
            var auth = BuildOperation(OpAuthenticate, BuildAuthParams());
            if (!peer.WaitPhase(auth, out var authTime))
            {
                peer.Close();
                res.Message = "Authenticate failed (no AuthResponse).";
                return res;
            }
            if (peer.LastResponseOperationCode != OpAuthenticate || peer.LastResponseReturnCode != ReturnOk)
            {
                peer.Close();
                res.Message = $"Authenticate failed: op={peer.LastResponseOperationCode} rc={(peer.LastResponseReturnCode == -1 ? "(none)" : peer.LastResponseReturnCode.ToString())}";
                return res;
            }

            // 4) CreateGame
            var create = BuildOperation(OpCreateGame, BuildCreateGameParams(null, lobbyName));
            if (!peer.WaitPhase(create, out var createTime))
            {
                peer.Close();
                res.Message = "CreateGame failed (no response).";
                return res;
            }

            res.CreateGameReturnCode = peer.LastResponseReturnCode;
            if (peer.LastResponseReturnCode == ReturnOk)
            {
                res.Success = true;
                res.Message = $"Game '{GameId}' created in app '{AppId}' (version '{AppVersion}').";
            }
            else if (peer.LastResponseReturnCode == GameIdAlreadyExists)
            {
                res.Success = true; // already there => also fine for our purposes
                res.Message = $"Game '{GameId}' already existed (returnCode=-3). Good.";
            }
            else
            {
                res.Message = $"CreateGame returned rc={peer.LastResponseReturnCode}.";
            }
            return res;
        }
        catch (Exception ex)
        {
            res.Message = $"PhotonGameCreator exception: {ex.GetType().Name}: {ex.Message}";
            return res;
        }
    }

    // A diagnostics-only join: connects as a plain user and issues
    // OpJoinGame (226) with CreateIfNotExists left absent (= false default).
    // Used to check whether the Luxon MasterServer answers the same kind of
    // JoinGame request the real client sends.
    public static Result ProbeJoin(string lobbyName = "", int waitMs = 8000)
    {
        var res = new Result();
        try
        {
            var cli = new UdpClient();
            cli.Connect(MasterServerHost, MasterServerPort);
            cli.Client.ReceiveTimeout = 600;

            var peer = new EnetClient(cli);

            if (!peer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8)))
            {
                peer.Close();
                res.Message = $"Join probe('{lobbyName}'): ENet handshake failed.";
                return res;
            }

            var init = BuildInit();
            if (!peer.WaitPhase(init, out _))
            {
                peer.Close();
                res.Message = $"Join probe('{lobbyName}'): Init failed.";
                return res;
            }

            var auth = BuildOperation(OpAuthenticate, BuildAuthParams());
            if (!peer.WaitPhase(auth, out _))
            {
                peer.Close();
                res.Message = $"Join probe('{lobbyName}'): Authenticate timeout.";
                return res;
            }
            if (peer.LastResponseOperationCode != OpAuthenticate || peer.LastResponseReturnCode != ReturnOk)
            {
                peer.Close();
                res.Message = $"Join probe('{lobbyName}'): Auth failed op={peer.LastResponseOperationCode} rc={peer.LastResponseReturnCode}.";
                return res;
            }

            var join = BuildOperation(OpJoinGame, BuildJoinGameParams(lobbyName));
            bool got = peer.WaitPhase(join, out _);
            if (!got)
            {
                peer.Close();
                res.Message = $"Join probe('{lobbyName}'): NO RESPONSE within ~{waitMs / 1000}s (silent).";
                return res;
            }

            res.CreateGameReturnCode = peer.LastResponseReturnCode;
            res.Message = $"Join probe('{lobbyName}'): op={peer.LastResponseOperationCode} rc={peer.LastResponseReturnCode}.";
            peer.Close();
            return res;
        }
        catch (Exception ex)
        {
            res.Message = $"PhotonGameCreator.ProbeJoin exception: {ex.GetType().Name}: {ex.Message}";
            return res;
        }
    }

