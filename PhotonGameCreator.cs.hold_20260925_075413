    internal static Result ProbeJoinEmptyIdFlagSweep()
    {
        var res = new Result();
        try
        {
            var hits = new System.Collections.Generic.List<string>();
            using (var cli = new UdpClient())
            {
                cli.Connect(MasterServerHost, MasterServerPort);
