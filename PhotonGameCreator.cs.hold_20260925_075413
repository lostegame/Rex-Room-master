    // Decisive same-connection experiment: create a NEW room with a fresh
    // unique id, then IMMEDIATELY JoinGame it on the SAME authenticated
    // connection, then re-CreateGame it. This proves whether the contains()
    // vs find() divergence is real on a single freshly-created game (server
    // bug) or only happens with long-lived/kept-alive rooms.
    internal static Result ProbeJoinFlagNoCreate(string newGameId, string lobbyName = "")
    {
        var res = new Result();
        try
        {
            var cli = new UdpClient();
            cli.Connect(MasterServerHost, MasterServerPort);
            cli.Client.ReceiveTimeout = 800;
            var peer = new EnetClient(cli);
            try
            {
                if (!peer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8))) { res.Message = $"FlagNoCreate('{lobbyName}'): ENet handshake failed."; return res; }
                var init = BuildInit();
                if (!peer.WaitPhase(init, out _)) { res.Message = $"FlagNoCreate('{lobbyName}'): Init failed."; return res; }
                var auth = BuildOperation(OpAuthenticate, BuildAuthParams());
                if (!peer.WaitPhase(auth, out _) || peer.LastResponseOperationCode != OpAuthenticate || peer.LastResponseReturnCode != ReturnOk)
                { res.Message = $"FlagNoCreate('{lobbyName}'): Auth failed op={peer.LastResponseOperationCode} rc={peer.LastResponseReturnCode}."; return res; }

                // JoinGame for a never-created FULL game id with CreateIfNotExists=1.
                var j = BuildOperation(OpJoinGame, BuildJoinGameFlagParams(newGameId, lobbyName, createIfNotExists: true));
                if (!peer.WaitPhase(j, out _)) { res.Message = $"FlagNoCreate('{lobbyName}'): JoinGame silent."; return res; }
                int joinRc = peer.LastResponseReturnCode;

                res.CreateGameReturnCode = joinRc;
                res.Message = $"FLAGNO-YET id={newGameId}: JoinFlag(no prior create)={joinRc}.";
                return res;
            }
            finally { peer.Close(); }
        }
        catch (Exception ex)
        {
            res.Message = $"PhotonGameCreator.ProbeJoinFlagNoCreate exception: {ex.GetType().Name}: {ex.Message}";
            return res;
        }
    }

