    // THE decisive end-to-end test matching the real Luxon flow. The master's
    // CreateGame only registers the room in the lobby game list; is_created
    // stays false until a SECOND connection authenticates on the GameServer
    // (game.cpp validate_join rejects !is_created with GameIdNotExists 32758).
    // We now replay that second leg:
    //   1) master CreateGame(freshId) -> capture Token from the response;
    //   2) close the master connection (stores the persistent peer+invitation);
    //   3) connect to the GameServer, TokenAuth, re-CreateGame the same id.
    //      handler_gameserver.cpp:397 then sets is_created=true;
    //   4) from a fresh master connection, JoinGame the same id WITHOUT flag.
    // Expected: step 3 rc=0 and step 4 rc=0 (was 32758 in all sweeps before).
    internal static Result ProbeSecondLegGameServer(string newGameId, string lobbyName = "")
    {
        var res = new Result();
        try
        {
            // ---- 1) master: create the room, capture token ----
            string token = null;
            using (var cli = new UdpClient())
            {
                cli.Connect(MasterServerHost, MasterServerPort);
                cli.Client.ReceiveTimeout = 600;
                var peer = new EnetClient(cli);
                try
                {
                    if (!peer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8))) { res.Message = $"2LEG('{lobbyName}'): ENet handshake failed."; return res; }
                    var init = BuildInit();
                    if (!peer.WaitPhase(init, out _)) { res.Message = $"2LEG('{lobbyName}'): Init failed."; return res; }
                    var auth = BuildOperation(OpAuthenticate, BuildAuthParams());
                    if (!peer.WaitPhase(auth, out _) || peer.LastResponseOperationCode != OpAuthenticate || peer.LastResponseReturnCode != ReturnOk)
                    { res.Message = $"2LEG('{lobbyName}'): Auth failed op={peer.LastResponseOperationCode} rc={peer.LastResponseReturnCode}."; return res; }

                    // CreateGame -> response must carry a Token (LoadBalancing::Token=221).
                    var c = BuildOperation(OpCreateGame, BuildCreateGameParams(newGameId, lobbyName));
                    if (!peer.WaitPhase(c, out _)) { res.Message = $"2LEG('{lobbyName}'): CreateGame silent."; return res; }
                    int createRc = peer.LastResponseReturnCode;
                    token = peer.LastResponseToken;
                    string addr = peer.LastResponseAddress;
                    res.CreateGameReturnCode = createRc;
                    if (createRc != ReturnOk || string.IsNullOrEmpty(token))
                    {
                        res.Message = $"2LEG('{lobbyName}'): Create rc={createRc} token='{token}' addr='{addr}' (need rc=0 + token).";
                        return res;
                    }
                }
                finally { peer.Close(); }  // stores persistent peer + invitation server-side
            }

            // Let the server notice the closed master connection. The master
            // handler stores the persistent peer (with the game invitation) only
            // when the connection is fully torn down server-side. The server
            // detects the teardown after ~9s but expunges the stored peer after
            // 30s, so sleep ~15s: comfortably after detection, before expiry.
            System.Threading.Thread.Sleep(15000);

            // ---- 3) GameServer leg: TokenAuth + CreateGame => is_created=true ----
            int gsAuthRc = int.MinValue, gsCreateRc = int.MinValue;
            using (var gcli = new UdpClient())
            {
                gcli.Connect(GameServerHost, GameServerPort);
                gcli.Client.ReceiveTimeout = 600;
                var gpeer = new EnetClient(gcli);
                try
                {
                    if (!gpeer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8))) { res.Message = $"2LEG('{lobbyName}'): GS handshake failed."; return res; }
                    var ginit = BuildInit();
                    if (!gpeer.WaitPhase(ginit, out _)) { res.Message = $"2LEG('{lobbyName}'): GS Init failed."; return res; }
                    var gauth = BuildOperation(OpAuthenticate, BuildTokenAuthParams(token));
                    if (!gpeer.WaitPhase(gauth, out _)) { res.Message = $"2LEG('{lobbyName}'): GS TokenAuth silent."; return res; }
                    gsAuthRc = gpeer.LastResponseReturnCode;
                    if (gsAuthRc != ReturnOk)
                    {
                        res.Message = $"2LEG('{lobbyName}'): GS TokenAuth rc={gsAuthRc} (expected 0).";
                        return res;
                    }

                    var gc = BuildOperation(OpCreateGame, BuildCreateGameParams(newGameId, lobbyName));
                    if (!gpeer.WaitPhase(gc, out _)) { res.Message = $"2LEG('{lobbyName}'): GS CreateGame silent."; return res; }
                    gsCreateRc = gpeer.LastResponseReturnCode;
                }
                finally { gpeer.Close(); }
            }

            // ---- 4) fresh master connection: JoinGame WITHOUT CreateIfNotExists ----
            int verifyRc = int.MinValue;
            using (var cli = new UdpClient())
            {
                cli.Connect(MasterServerHost, MasterServerPort);
                cli.Client.ReceiveTimeout = 600;
                var vpeer = new EnetClient(cli);
                try
                {
                    if (!vpeer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8))) { res.Message = $"2LEG('{lobbyName}'): verify ENet handshake failed."; return res; }
                    var vinit = BuildInit();
                    if (!vpeer.WaitPhase(vinit, out _)) { res.Message = $"2LEG('{lobbyName}'): verify Init failed."; return res; }
                    var vauth = BuildOperation(OpAuthenticate, BuildAuthParams());
                    if (!vpeer.WaitPhase(vauth, out _) || vpeer.LastResponseOperationCode != OpAuthenticate || vpeer.LastResponseReturnCode != ReturnOk)
                    { res.Message = $"2LEG('{lobbyName}'): verify Auth failed op={vpeer.LastResponseOperationCode} rc={vpeer.LastResponseReturnCode}."; return res; }

                    var vj = BuildOperation(OpJoinGame, BuildJoinGameParamsOf(newGameId, lobbyName));
                    if (!vpeer.WaitPhase(vj, out _)) { res.Message = $"2LEG('{lobbyName}'): verify JoinGame silent."; return res; }
                    verifyRc = vpeer.LastResponseReturnCode;
                }
                finally { vpeer.Close(); }
            }

            // ---- 5) fresh master connection AS A DIFFERENT PLAYER ----
            int otherRc = int.MinValue;
            using (var cli = new UdpClient())
            {
                cli.Connect(MasterServerHost, MasterServerPort);
                cli.Client.ReceiveTimeout = 600;
                var op = new EnetClient(cli);
                try
                {
                    if (!op.ConnectAndWaitConnected(TimeSpan.FromSeconds(8))) { res.Message = $"2LEG('{lobbyName}'): other ENet handshake failed."; return res; }
                    var oinit = BuildInit();
                    if (!op.WaitPhase(oinit, out _)) { res.Message = $"2LEG('{lobbyName}'): other Init failed."; return res; }
                    var oauth = BuildOperation(OpAuthenticate, BuildAuthParamsOther("probe-visitor-" + DateTime.UtcNow.Ticks.ToString("x")));
                    if (!op.WaitPhase(oauth, out _) || op.LastResponseOperationCode != OpAuthenticate || op.LastResponseReturnCode != ReturnOk)
                    { res.Message = $"2LEG('{lobbyName}'): other Auth failed op={op.LastResponseOperationCode} rc={op.LastResponseReturnCode}."; return res; }

                    var oj = BuildOperation(OpJoinGame, BuildJoinGameParamsOf(newGameId, lobbyName));
                    if (!op.WaitPhase(oj, out _)) { res.Message = $"2LEG('{lobbyName}'): other JoinGame silent."; return res; }
                    otherRc = op.LastResponseReturnCode;
                }
                finally { op.Close(); }
            }

            res.Message = $"2LEG('{lobbyName}') id={newGameId}: Create={res.CreateGameReturnCode} GS-Auth={gsAuthRc} GS-Create={gsCreateRc} VerifyJoin={verifyRc} OtherJoin={otherRc}.";
            return res;
        }
        catch (Exception ex)
        {
