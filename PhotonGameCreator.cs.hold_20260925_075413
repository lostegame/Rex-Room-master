    internal static Result ProbeCreateThenJoinSameConn(string newGameId, string lobbyName = "")

    {
        var res = new Result();
        try
        {
            var cli = new UdpClient();
            cli.Connect(MasterServerHost, MasterServerPort);
            cli.Client.ReceiveTimeout = 600;
            var peer = new EnetClient(cli);
            try
            {
                if (!peer.ConnectAndWaitConnected(TimeSpan.FromSeconds(8))) { res.Message = $"SameConn('{lobbyName}'): ENet handshake failed."; return res; }
                var init = BuildInit();
                if (!peer.WaitPhase(init, out _)) { res.Message = $"SameConn('{lobbyName}'): Init failed."; return res; }
                var auth = BuildOperation(OpAuthenticate, BuildAuthParams());
                if (!peer.WaitPhase(auth, out _) || peer.LastResponseOperationCode != OpAuthenticate || peer.LastResponseReturnCode != ReturnOk)
                { res.Message = $"SameConn('{lobbyName}'): Auth failed op={peer.LastResponseOperationCode} rc={peer.LastResponseReturnCode}."; return res; }

                // 1) CreateGame with fresh unique id (expect rc=0 = created)
                var c = BuildOperation(OpCreateGame, BuildCreateGameParams(newGameId, lobbyName));
                if (!peer.WaitPhase(c, out _)) { res.Message = $"SameConn('{lobbyName}'): CreateGame(new) silent."; return res; }
                int createNew = peer.LastResponseReturnCode;

                // 2) JoinGame same id (expect rc=0 = found)
                var j = BuildOperation(OpJoinGame, BuildJoinGameParamsOf(newGameId, lobbyName));
                if (!peer.WaitPhase(j, out _)) { res.Message = $"SameConn('{lobbyName}'): JoinGame(new) silent."; return res; }
                int joinNew = peer.LastResponseReturnCode;

                // 3) CreateGame same id again (expect rc=-3 = already exists)
                var c2 = BuildOperation(OpCreateGame, BuildCreateGameParams(newGameId, lobbyName));
                if (!peer.WaitPhase(c2, out _)) { res.Message = $"SameConn('{lobbyName}'): ReCreate silent."; return res; }
                int createAgain = peer.LastResponseReturnCode;

                res.CreateGameReturnCode = joinNew;
                res.Message = $"SameConn('{lobbyName}') id={newGameId}: CreateNew={createNew} JoinNew={joinNew} CreateAgain={createAgain}.";
                return res;
            }
            finally { peer.Close(); }
        }
        catch (Exception ex)
        {
            res.Message = $"PhotonGameCreator.ProbeCreateThenJoinSameConn exception: {ex.GetType().Name}: {ex.Message}";
            return res;
        }
    }

