    private static byte[] Wrap(byte kind, List<byte> body)
    {
        var outBytes = new byte[2 + body.Count];
        outBytes[0] = 0xF3;
        outBytes[1] = kind;
        body.CopyTo(outBytes, 2);
        return outBytes;
    }

    private static void AddString(List<byte> dst, byte key, string val)
    {
        dst.Add(key);
        dst.Add(TCString);
        var bytes = Encoding.UTF8.GetBytes(val ?? "");
        WriteVarUInt32(dst, (uint)bytes.Length);
        dst.AddRange(bytes);
    }

    private static void AddBool(List<byte> dst, byte key, bool val)
    {
        dst.Add(key);
        dst.Add(TCBooleanTrue); // true -> 0x1C
    }

    private static void AddByte(List<byte> dst, byte key, byte val)
    {
        dst.Add(key);
        if (val == 0)
        {
            dst.Add(TCByteZero);
        }
        else
        {
            dst.Add(0x03);
            dst.Add(val);
        }
    }

    private static void WriteVarUInt32(List<byte> dst, uint value)
    {
        do
        {
            byte b = (byte)(value & 0x7F);
            value >>= 7;
            if (value != 0)
                b |= 0x80;
            dst.Add(b);
        } while (value != 0);
    }

    // ==================================================================
    //  Minimal ENet client
    // ==================================================================
    internal sealed class EnetClient
    {
        private readonly UdpClient _sock;
        private uint _challenge;
        private int _peerId = -1;               // -1 for connect packet (0xFFFF)
        private uint _channel0Seq = 0;          // reliable seq for channel 0
        private readonly List<SentReliable> _sentReliable = new();
        private readonly List<byte[]> _pendingAcks = new();

        public byte LastResponseOperationCode { get; private set; }
        public short LastResponseReturnCode { get; private set; } = -1;
        public string LastResponseToken { get; private set; }
        public string LastResponseAddress { get; private set; }

        private sealed class SentReliable
        {
            public byte Channel;
            public uint Seq;
            public byte[] Payload;
            public uint SentAt;
            public int SentCount;
        }

        private static IPEndPoint _dummyEndpoint = new(IPAddress.Any, 0);

        public EnetClient(UdpClient sock)
        {
            _sock = sock;
            var rnd = new Random();
            _challenge = (uint)(rnd.Next() * 2 ^ rnd.Next());
            if (_challenge == 0) _challenge = 0x12345678u;
        }

        public void Close() { try { _sock.Close(); } catch { } }

        // Keep the authenticated connection alive: process incoming datagrams
        // (ack/the server ping) and resend anything the server hasn't acked,
        // indefinitely. Returns when the socket is gone.
        public void KeepAliveLoop(TimeSpan resendInterval)
        {
            while (true)
            {
                try
                {
                    if (!ProcessNextDatagram(200))
                    {
                        // No datagram: resend anything older than resendInterval.
                        int now = Environment.TickCount;
                        bool resent = false;
                        for (int i = 0; i < _sentReliable.Count; i++)
                        {
                            if (now - _sentReliable[i].SentAt > resendInterval.TotalMilliseconds)
                            {
                                _sentReliable[i].SentAt = unchecked((uint)now);
                                var built = BuildCommand(_sentReliable[i].Channel, _sentReliable[i].Seq, _sentReliable[i].Payload, out _);
                                _pendingAcks.Add(built);
                                resent = true;
                            }
                        }
                        if (resent)
                        {
                            SendPacketHeader(_pendingAcks);
                            _pendingAcks.Clear();
                        }
                    }
                }
                catch
                {
                    return; // socket closed or connection dead
                }
            }
        }

        public bool ConnectAndWaitConnected(TimeSpan timeout)
        {
            // Send Connect command (ControlChannel, reliable, seq=1)
            var connect = new SentReliable { Channel = ControlChannel, Seq = 1, Payload = BuildConnectPayload(), SentAt = Tick() };
            _sentReliable.Add(connect);
            SendPacket(connect.Channel, connect.Seq, connect.Payload, control: true);

            var deadline = Environment.TickCount + (int)timeout.TotalMilliseconds;
            while (!_connected)
            {
                int now = Environment.TickCount;
                if (now >= deadline)
                {
                    // timeout -> resend unacked
                    if (!ResendTimedOut(deadline)) return false;
                    if (now >= deadline) return false;
                    continue;
                }

                int remaining = Math.Max(1, deadline - now);
                if (!ProcessNextDatagram(remaining))
                {
                    if (!_connected)
                    {
                        if (!ResendTimedOut(deadline)) return false;
                        if (Environment.TickCount >= deadline) return false;
                    }
                }
            }

            // We become connected locally upon receiving VerifyConnect; flush ack.
            return _connected;
        }

        private bool _connected;

        // Sends a reliable payload on channel 0 and waits for the next
        // response-routing command (InitResponse / OperationResponse).
        public bool WaitPhase(byte[] payload, out int completedAt)
        {
            completedAt = 0;
            _phaseDone = false;
            _channel0Seq++;
            var sent = new SentReliable { Channel = 0, Seq = _channel0Seq, Payload = payload, SentAt = Tick() };
            _sentReliable.Add(sent);
            SendPacket(sent.Channel, sent.Seq, sent.Payload, control: false);

            var deadline = Environment.TickCount + 8000;
            while (!_phaseDone)
            {
                int now = Environment.TickCount;
                if (now >= deadline)
                {
                    if (!ResendTimedOut(deadline)) return false;
                    if (Environment.TickCount >= deadline) return false;
                    continue;
                }
                int remaining = Math.Max(1, deadline - now);
                if (!ProcessNextDatagram(remaining))
                {
                    if (!_phaseDone && !ResendTimedOut(deadline) && Environment.TickCount >= deadline)
                        return false;
                }
            }
            completedAt = Environment.TickCount;
            return _phaseDone;
        }

        private bool _phaseDone;

        private byte[] BuildConnectPayload()
        {
            // 32-byte connect payload (magic constants, from send_connect())
            var payload = new byte[32];
            payload[2] = (byte)(1200 >> 8);        // mtu high
            payload[3] = (byte)(1200 & 0xFF);      // mtu low
            payload[6] = 128;
            payload[11] = 2;                        // channel_count
            payload[22] = 19;
            payload[23] = 136;
            payload[27] = 2;
            payload[31] = 2;
            return payload;
        }

        private static uint Tick() => unchecked((uint)Environment.TickCount);

        // Read the next datagram from socket, parse ENet packet, dispatch.
        // Returns false if timeout elapsed with no datagram.
        private bool ProcessNextDatagram(int timeoutMs)
        {
            byte[] data;
            try
            {
                data = _sock.Receive(ref _dummyEndpoint);
            }
            catch (SocketException ex)
            {
                // A deadline timeout is normal (nothing arrived). A reset /
                // not-connected / shutdown means the remote Luxon server went
                // away: treat that as fatal so KeepAliveLoop exits and the
                // keepalive loop reconnects+recreates the room.
                if (ex.SocketErrorCode == SocketError.TimedOut || ex.SocketErrorCode == SocketError.WouldBlock)
                    return false; // timeout
                throw; // dead socket -> KeepAliveLoop catch returns
            }
            if (data == null) return false;

            HandlePacket(data);
            // Flush any ACKs we queued for reliable commands received from server.
            FlushAcks();
            return true;
        }

        private void HandlePacket(byte[] p)
        {
            if (p.Length < 12) return;

            uint sentTime = ReadU32BE(p, 4);
            int off = 12; // after peer_id(2)+type(1)+count(1)+sentTime(4)+challenge(4)

            // TODO: for robustness we could validate challenge here.

            while (off + 6 <= p.Length)
            {
                byte type = p[off];
                byte channel = p[off + 1];
                byte flags = p[off + 2];
                // reserved byte at off+3
                uint cmdLen = ReadU32BE(p, off + 4);
                uint reliableSeq = ReadU32BE(p, off + 8);

                if (cmdLen < 12 || off + (int)cmdLen > p.Length)
                    break;

                // If reliable, we must ACK it (use the packet's sentTime).
                if ((flags & FlagReliable) != 0)
                    QueueAck(type, channel, flags, reliableSeq, sentTime);

                int payloadStart = off + 12;
                int payloadLen = (int)cmdLen - 12;

                switch (type)
                {
                    case CmdConnect: // (server -> us for Connect shouldn't happen, ignore)
                        break;
                    case CmdVerifyConnect:
                        if (payloadLen >= 2)
                        {
                            int pid = (p[payloadStart] << 8) | p[payloadStart + 1];
                            if (_peerId == -1 || _peerId == -2)
                                _peerId = pid;
                            _connected = true;
                            _phaseDone = true;
                        }
                        break;
                    case CmdAcknowledge:
                        if (payloadLen >= 8)
                        {
                            uint ackedSeq = ReadU32BE(p, payloadStart);
                            // channel that was acked is in 'channel' field
                            for (int i = _sentReliable.Count - 1; i >= 0; i--)
                            {
                                var s = _sentReliable[i];
                                if (s.Seq == ackedSeq && s.Channel == channel)
                                {
                                    _sentReliable.RemoveAt(i);
                                    break;
                                }
                            }
                        }
                        break;
                    case CmdSendReliable:
                    {
                        if (payloadLen > 0)
                        {
                            var msg = new byte[payloadLen];
                            Array.Copy(p, payloadStart, msg, 0, payloadLen);
                            HandleGpMessage(msg);
                        }
                        break;
                    }
                    case CmdPing:
                        // nothing to do (already ACKed above)
                        break;
                }

                off += (int)cmdLen;
            }
        }

        private void HandleGpMessage(byte[] msg)
        {
            if (msg.Length < 2 || msg[0] != 0xF3) return;
            byte kind = (byte)(msg[1] & 0x7F);
            switch (kind)
            {
                case KindInitResponse:
                    _phaseDone = true;
                    break;
                case KindOperationResponse:
                    ParseOperationResponse(msg);
                    _phaseDone = true;
                    break;
            }
        }

        private void ParseOperationResponse(byte[] msg)
        {
            // layout: F3, kindB(3), operationCode, returnCode(2 LE), debugMessage(typed), params
            // debugMessage is TC18_Null(0x08) or TC18_String(0x07)+len+bytes.
            // params: count(u8) then [key(u8), typed value...].
            int i = 2;
            if (i >= msg.Length) return;
            byte opCode = msg[i++];
            if (i + 2 > msg.Length) return;
            short rc = (short)(msg[i] | (msg[i + 1] << 8)); // int16 LE
            i += 2;
            LastResponseOperationCode = opCode;
            LastResponseReturnCode = rc;
            LastResponseToken = null;
            LastResponseAddress = null;

            if (i >= msg.Length) return;
            byte debugType = msg[i++];
            if (debugType == TCString) // TC18_String - skip debug message
            {
                if (!TrySkipVarString(msg, ref i)) return;
            }
            else if (debugType != 0x08) // TC18_Null
            {
                return; // unexpected debug field
            }

            if (i >= msg.Length) return;
            int count = msg[i++];
            for (int n = 0; n < count && i < msg.Length; n++)
            {
                byte key = msg[i++];
                if (i >= msg.Length) return;
                byte type = msg[i++];
                if (type == TCString)
                {
                    if (!TryReadVarString(msg, ref i, out string str)) return;
                    if (key == KeyToken) LastResponseToken = str;
                    else if (key == 230) LastResponseAddress = str;
                }
                else
                {
                    if (!SkipValue(type, msg, ref i)) return;
                }
            }
        }

        // Reads varuint32-prefixed UTF-8 string. Returns false if truncated.
        private static bool TryReadVarString(byte[] msg, ref int i, out string strVal)
        {
            strVal = null;
            if (!TryReadVarUInt(msg, ref i, out uint len)) return false;
            if (len > int.MaxValue || i + (int)len > msg.Length) return false;
            strVal = Encoding.UTF8.GetString(msg, i, (int)len);
            i += (int)len;
            return true;
        }

        private static bool TrySkipVarString(byte[] msg, ref int i)
        {
            if (!TryReadVarUInt(msg, ref i, out uint len)) return false;
            if (len > int.MaxValue || i + (int)len > msg.Length) return false;
            i += (int)len;
            return true;
        }

        // Reads varuint32. Returns false if truncated.
        private static bool TryReadVarUInt(byte[] msg, ref int i, out uint value)
        {
            value = 0;
            int shift = 0;
            for (int b = 0; b < 5 && i < msg.Length; b++)
            {
                byte cur = msg[i++];
                value |= (uint)(cur & 0x7F) << shift;
                if ((cur & 0x80) == 0) return true;
                shift += 7;
            }
            return false;
        }

        // Skips a single GpBinaryV18 typed value given its type code.
        private static bool SkipValue(byte type, byte[] msg, ref int i)
        {
            switch (type)
            {
                case 0x08: return true;                                   // Null
                case 0x1C: case 0x1B: return true;                        // BooleanTrue / BooleanFalse
                case 0x22: case 0x1D: case 0x1E: case 0x1F: case 0x20: case 0x21: return true; // Zero values
                case 0x03: return SkipBytes(msg, ref i, 1);               // Byte
                case 0x05: return SkipBytes(msg, ref i, 2);               // Short
                case 0x02: return SkipBytes(msg, ref i, 4);               // Float
                case 0x04: return SkipBytes(msg, ref i, 4);               // Int
                case 0x06: return SkipBytes(msg, ref i, 8);               // Long
                case 0x09: return TryReadVarUInt(msg, ref i, out _);      // CompressedInt
                case 0x0A: for (int k = 0; k < 10 && i < msg.Length; k++) { if ((msg[i++] & 0x80) == 0) return true; } return false; // CompressedLong
                case TCString: return TrySkipVarString(msg, ref i);       // String
                default: return false;                                    // unknown -> stop parsing (params trailing)
            }
        }

        private static bool SkipBytes(byte[] msg, ref int i, int n)
        {
            if (i + n > msg.Length) return false;
            i += n;
            return true;
        }

        private void QueueAck(byte cmdType, byte channel, byte flags, uint reliableSeq, uint sentTime)
        {
            // Build 20-byte ACK command.
            var ack = new byte[20];
            ack[0] = CmdAcknowledge;      // type
            ack[1] = channel;             // channel of the acked command
            ack[2] = 0;                   // flags
            ack[3] = 4;                   // reserved
            WriteU32BE(ack, 4, 20);       // command_length
            WriteU32BE(ack, 8, 0);        // reliable_seq = 0
            WriteU32BE(ack, 12, reliableSeq); // ack_received_reliable_sequence_number
            WriteU32BE(ack, 16, sentTime);    // ack_received_sent_time
            _pendingAcks.Add(ack);
        }

        private void FlushAcks()
        {
            if (_pendingAcks.Count == 0) return;
            var cmds = new List<byte[]>(_pendingAcks);
            _pendingAcks.Clear();
            SendPacketHeader(cmds);
        }

        private void SendPacket(byte channel, uint seq, byte[] payload, bool control)
        {
            var cmd = BuildCommand(channel, seq, payload, out _);
            SendPacketHeader(new List<byte[]> { cmd });
        }

        private byte[] BuildCommand(byte channel, uint seq, byte[] payload, out uint totalLen)
        {
            int payloadLen = payload?.Length ?? 0;
            totalLen = (uint)(12 + payloadLen);
            var cmd = new byte[12 + payloadLen];
            cmd[0] = channel == ControlChannel ? CmdConnect : CmdSendReliable;
            cmd[1] = channel;
            cmd[2] = FlagReliable;
            cmd[3] = 4;                      // reserved=4
            WriteU32BE(cmd, 4, totalLen);
            WriteU32BE(cmd, 8, seq);
            if (payloadLen > 0)
                Array.Copy(payload, 0, cmd, 12, payloadLen);
            return cmd;
        }

        private void SendPacketHeader(List<byte[]> commands)
        {
            int len = 12;
            foreach (var c in commands) len += c.Length;
            var packet = new byte[len];
            WriteU16BE(packet, 0, (ushort)((uint)_peerId & 0xFFFF));
            packet[2] = 0;                                  // type = PlainNoCrc
            packet[3] = (byte)commands.Count;               // command_count
            WriteU32BE(packet, 4, Tick());                  // sent_time
            WriteU32BE(packet, 8, _challenge);              // challenge
            int o = 12;
            foreach (var c in commands)
            {
                Array.Copy(c, 0, packet, o, c.Length);
                o += c.Length;
            }
            SendAll(packet);
        }

        private void SendAll(byte[] packet)
        {
            try
            {
                _sock.Send(packet, packet.Length);
            }
            catch { }
        }

        private bool ResendTimedOut(int deadline)
        {
            int now = Environment.TickCount;
            bool found = false;
            var toResend = new List<SentReliable>();
            for (int i = 0; i < _sentReliable.Count; i++)
            {
                now = Environment.TickCount;
                if (now - _sentReliable[i].SentAt > 1000 && _sentReliable[i].SentCount < 10)
                {
                    toResend.Add(_sentReliable[i]);
                    found = true;
                }
            }
            foreach (var s in toResend)
            {
                s.SentAt = unchecked((uint)Environment.TickCount);
                s.SentCount++;
                var built = BuildCommand(s.Channel, s.Seq, s.Payload, out _);
                _pendingAcks.Add(built);
            }
            if (found)
            {
                SendPacketHeader(_pendingAcks);
                _pendingAcks.Clear();
            }
            return found;
        }
    }

    // Read little-endian u16
    private static ushort ReadU16LE(byte[] b, int off) => (ushort)(b[off] | (b[off + 1] << 8));

    private static uint ReadU32BE(byte[] b, int off) =>
        ((uint)b[off] << 24) | ((uint)b[off + 1] << 16) | ((uint)b[off + 2] << 8) | b[off + 3];

    private static void WriteU32BE(byte[] b, int off, uint v)
    {
        b[off] = (byte)(v >> 24);
        b[off + 1] = (byte)(v >> 16);
        b[off + 2] = (byte)(v >> 8);
        b[off + 3] = (byte)v;
    }

    private static void WriteU16BE(byte[] b, int off, ushort v)
    {
        b[off] = (byte)(v >> 8);
        b[off + 1] = (byte)v;
    }
